/* Aero Frost Theme */
/* Inspired by frosted glass and cool blues of Windows 7 Aero */

QWidget {
    font-family: "Segoe UI";
    font-size: 12px;
    color: #eaf6ff;
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1a252f,
        stop:1 #0f161c
    );
}

/* Main window */
QMainWindow {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #273848,
        stop:0.5 #1c2a36,
        stop:1 #0f161c
    );
    border: 1px solid #5aa3d8;
}

/* Menu bar */
QMenuBar {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #2a3f52,
        stop:0.5 #1e2d3b,
        stop:1 #141e26
    );
    border-bottom: 1px solid #4c91c9;
}

QMenuBar::item {
    color: #cfe9ff;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #68b3ff,
        stop:1 #3a80c1
    );
    border-radius: 3px;
}

/* Menus */
QMenu {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1e2c39,
        stop:1 #141c24
    );
    border: 1px solid #4c91c9;
}

QMenu::item {
    padding: 5px 25px;
    color: #eaf6ff;
}

QMenu::item:selected {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #6ec0ff,
        stop:1 #408fd3
    );
    border-radius: 2px;
}

/* Buttons */
QPushButton {
    color: #eaf6ff;
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #4a9ade,
        stop:0.5 #337fbc,
        stop:1 #1c5e8f
    );
    border: 2px solid #66b2ff;
    border-radius: 10px;
    font-weight: bold;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #6ec0ff,
        stop:0.5 #4c9ae0,
        stop:1 #2f78b8
    );
    border: 2px solid #9cd7ff;
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #24577c,
        stop:1 #163c59
    );
    border: 2px solid #5aa3d8;
}

/* Tables */
QTableWidget {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #203243,
        stop:1 #16232f
    );
    alternate-background-color: #192834;
    gridline-color: #4c91c9;
    selection-background-color: #3a80c1;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #4c9ae0,
        stop:1 #2f78b8
    );
    color: #eaf6ff;
    padding: 4px;
    border: 1px solid #5aa3d8;
    font-weight: bold;
}

/* ComboBox */
QComboBox {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #337fbc,
        stop:1 #1e5c8a
    );
    border: 1px solid #66b2ff;
    border-radius: 5px;
    padding: 4px 8px;
    color: #eaf6ff;
}

QComboBox:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #6ec0ff,
        stop:1 #408fd3
    );
}

/* Lists and selections */
QAbstractItemView {
    background-color: #17232f;
    selection-background-color: #3a80c1;
    selection-color: #ffffff;
}

/* Text fields */
QLineEdit {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #24384a,
        stop:1 #182630
    );
    border: 1px solid #66b2ff;
    border-radius: 6px;
    padding: 4px 6px;
    color: #eaf6ff;
}

/* Progress bar */
QProgressBar {
    background-color: #0f161c;
    border: 1px solid #4c91c9;
    border-radius: 8px;
    text-align: center;
    color: #eaf6ff;
}

QProgressBar::chunk {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #6ec0ff,
        stop:1 #408fd3
    );
    border-radius: 8px;
}
